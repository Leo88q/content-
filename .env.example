# =========================================================================
# TalkChart trafficgen — пример переменных окружения.
# ЗНАЧЕНИЯ ЗДЕСЬ НИКОГДА НЕ ХРАНЯТСЯ. Реальные значения — только через
# секрет-менеджер (GitHub Secrets / env рантайма). См. PROMPT §10.2.
# =========================================================================

# Read-only токен Games Watchtower (имя — не значение).
# Если установлен — все GET /watchtower/* требуют "Authorization: Bearer <token>".
WATCHTOWER_READ_TOKEN=

# Предыдущий токен на период бесшовной ротации (оба валидны одновременно).
WATCHTOWER_READ_TOKEN_PREVIOUS=

# Лимит приёма клиентской телеметрии: запросов в секунду и всплеск.
WATCHTOWER_TRACK_RPS=30
WATCHTOWER_TRACK_BURST=30

# Публичный URL сайта (canonical, ссылки дайджестов).
TALKCHART_SITE_URL=https://leo88q.github.io/content-/site

# Полный access-log сервера (без тел запросов и без query-строк всё равно).
WATCHTOWER_DEBUG_LOGS=
